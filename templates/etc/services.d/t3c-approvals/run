#!/command/with-contenv bash
# The t3c-approvals service: reviews T3 Code approvals with an agent (/usr/local/bin/t3c-approvals).
# A legacy s6-overlay longrun, so that the playbook can add it: s6-overlay compiles s6-rc.d before
# ansible-setup runs, and copies /etc/services.d into /run/service after it.
exec s6-setuidgid vscode env HOME=/home/vscode USER=vscode LOGNAME=vscode \
    /usr/local/bin/t3c-approvals serve 2>&1
