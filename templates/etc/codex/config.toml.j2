# System defaults for every Codex session: https://learn.chatgpt.com/docs/config-file/config-reference
# Codex reads /etc/codex/config.toml (defaults), managed_config.toml and requirements.toml (constraints).
# Only what Codex never writes to the user's ~/.codex/config.toml belongs here; a value Codex writes there
# overrides this file for good. The notice and tui settings are in the user file, kept by a chezmoi
# modify template (workspace-dotfiles); the model is the user's.

# Wyrd plugins, from the checkout the playbook keeps at {{ agent_marketplace_dir }}. A local source,
# so no session clones it: inside a T3 thread with no registered operator the git shim refuses git.
[marketplaces.wyrd-company]
source_type = "local"
source = "{{ agent_marketplace_dir }}"

# git-operator is a SessionStart hook. Codex runs a plugin's hook only after each user trusts it,
# and trust is per user, so a system layer cannot grant it. A managed hook runs without review:
# it runs the plugin's own script from the checkout. The git-operator plugin stays disabled, so
# the hook cannot run twice.
[[hooks.SessionStart]]
[[hooks.SessionStart.hooks]]
type = "command"
command = "sh {{ agent_marketplace_dir }}/plugins/git-operator/scripts/session-start.sh"
timeout = 10

# The mnemonic memory server. Like the hook above, it runs the plugin's script from the checkout:
# a system layer cannot install a plugin for each user. The script starts the server under
# envconsul with /etc/mnemonic/config.hcl, which reads the Xolotl embedding key from Vault.
# Codex gives an MCP server only HOME, PATH, USER and a few more variables; env_vars forwards the
# Vault socket and homelab CA (envconsul, embeddings), and the thread id and SSH agent, so the git
# shim commits mnemonic's notes as the thread's operator.
[mcp_servers.mnemonic]
command = "sh"
args = ["{{ agent_marketplace_dir }}/plugins/mnemonic/scripts/mnemonic-mcp.sh"]
env_vars = ["VAULT_ADDR", "NODE_EXTRA_CA_CERTS", "T3CODE_THREAD_ID", "SSH_AUTH_SOCK", "GIT_OPERATOR"]
