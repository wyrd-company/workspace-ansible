#https://learn.chatgpt.com/docs/config-file/config-reference
# Models come from Xolotl; the client key is fetched through the Wyrwood vault socket on demand.
model_provider = "xolotl"
model = "gpt-6-luna"

[model_providers.xolotl]
name = "Xolotl"
base_url = "{{ xolotl_url }}/v1"
wire_api = "responses"

[model_providers.xolotl.auth]
command = "bao kv get -field=api_key kv/xolotl/keys/{{xolotl_key}}"

[notice]
hide_full_access_warning = true
hide_rate_limit_model_nudge = true

[tui]
status_line = ["model-with-reasoning", "current-dir", "context-window-size", "context-used", "used-tokens", "five-hour-limit", "weekly-limit", "codex-version", "thread-title", "task-progress"]
status_line_use_colors = true
screen_reader_detection_done = true