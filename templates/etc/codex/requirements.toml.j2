# Constraints every Codex session must meet: https://learn.chatgpt.com/docs/enterprise/managed-configuration
# The plugin marketplace and the git-operator hook are in config.toml; the notice and tui settings are in
# the user's ~/.codex/config.toml (workspace-dotfiles); the model is the user's.

# Models come from Xolotl; the client key is fetched through the Wyrwood vault socket on demand.
model_provider = "xolotl"

[model_providers.xolotl]
name = "Xolotl"
base_url = "{{ xolotl_url }}/v1"
wire_api = "responses"

[model_providers.xolotl.auth]
command = "bao"
args = ["kv", "get", "-field=api_key", "kv/xolotl/keys/{{xolotl_key}}"]

# The git-operator hook (config.toml) needs hooks on.
[features]
hooks = true
