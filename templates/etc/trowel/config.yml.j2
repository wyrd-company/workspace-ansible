server:
  listen: ":9090"

# The Wyrwood socket adds the container's token, so no auth section.
vault:
  address: unix:///run/wyrwood/vault.sock
  kv_mount: kv

nats:
  url: {{nats_url}}
  name: {{workspace}}-trowel
  # The workspace user's .creds, shared by every workspace (homelab repo, role nats)
  creds_vault: {path: homelab/nats/workspace, field: creds}

# Pushes to the workspace's own repositories enqueue the workspace-update DAGs
# (workflows repo, main, /workflows/main/sub-dags/workspace-update-*.yml), which
# apply them.
#
# The homelab relay publishes GitHub webhooks to stream GITHUB as
# github.<owner>.<repo>.<event>.<action>, and a push has no action, so a subject
# names every push to a repository, whatever the branch. The DAGs skip pushes
# that are not to main: the transform passes them the ref and head commit as
# Dagu params, a JSON object on stdin.
#
# Each relay has a durable consumer per destination, relay-<name>-<destination>.
# deliver_policy new: on first start, do not replay the stream's 30 days of pushes.
subjects:
{% for relay in [
  {'name': 'ansible', 'repo': 'workspace-ansible', 'dag': 'workspace-update-ansible'},
  {'name': 'dotfiles', 'repo': 'workspace-dotfiles', 'dag': 'workspace-update-dotfiles'},
  {'name': 'skills', 'repo': 'skills', 'dag': 'workspace-update-dotfiles'},
  {'name': 'workflows', 'repo': 'workflows', 'dag': 'workspace-update-workflows'},
] %}
  - name: {{workspace}}-{{relay.name}}
    subject: github.{{org}}.{{relay.repo}}.push.none
    transform:
      payload: '{"REF": payload.ref, "SHA": payload.after}'
    consumer:
      deliver_policy: new
      # Without a backoff the five attempts follow each other at once. JetStream uses
      # backoff[0] as the first ack deadline, and trowel does not extend it while the
      # command runs, so keep it well above the command's timeout: a redelivery while
      # an enqueue still runs would queue a second apply.
      backoff: [1m, 5m, 15m, 30m]
    destinations:
      - name: dagu
        command:
          # Dagu's own configuration, so base.yml and the queues are the server's. The DAG by
          # path: enqueue finds a bare name only in dags_dir, not in the sub-dags.
          argv:
            - /usr/local/bin/dagu
            - enqueue
            - --config
            - /etc/dagu/config.yml
            - --params-stdin
            - /workflows/main/sub-dags/{{relay.dag}}.yml
          # An enqueue takes well under a second; below backoff[0], see above
          timeout: 20s
{% endfor %}

  # Discord activity in threads that deck touched (deck service, stream DECK, subjects
  # deck.<server>.<channel>.<thread>) wakes the T3 Code threads that posted or replied
  # there. Every workspace consumes every event; deck-wake-t3 resolves the thread
  # against this workspace's own deck store, so a thread no local session touched is
  # a successful no-op. See templates/usr/local/bin/deck-wake-t3.
  - name: {{workspace}}-deck
    subject: deck.>
    consumer:
      # On first start, do not wake threads for the stream's week of old activity
      deliver_policy: new
      # backoff[0] is the first ack deadline; keep it above the command's timeout,
      # as above, so a slow send is not notified twice.
      backoff: [1m, 5m, 15m, 30m]
    destinations:
      - name: t3
        command:
          argv:
            - /usr/local/bin/deck-wake-t3
          # A resolve reads only the local store, and a send queues a turn without waiting for it
          timeout: 30s
