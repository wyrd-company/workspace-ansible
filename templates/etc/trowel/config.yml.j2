server:
  listen: ":9090"

# The Wyrwood socket adds the container's token, so no auth section.
vault:
  address: unix:///run/wyrwood/vault.sock
  kv_mount: kv

nats:
  url: {{nats_url}}
  name: {{workspace}}-trowel
  # The workspace user's .creds, shared by every workspace (homelab repo, role nats)
  creds_vault: {path: homelab/nats/workspace, field: creds}

subjects:
  - name: {{workspace}}-ansible
    subject: webhooks.github.{{org}}.workspace-ansible.release.new
    destinations:
      - name: sync
        command:
          argv:
            - sudo
            - ansible-sync
          # ansible-sync reruns the whole playbook; the 60s default would kill it
          timeout: 30m
  - name: {{workspace}}-dotfiles
    subject: webhooks.github.{{org}}.workspace-dotfiles.main.push
    destinations:
      - name: chezmoi
        command:
          argv:
            - chezmoi
            - update
            - --init
          dir: /home/vscode
          env:
            BAO_ADDR: unix:///run/wyrwood/vault.sock