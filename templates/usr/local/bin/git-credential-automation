#!/bin/sh
# git credential helper for wyrd-automation[bot]: mints the token for the org that owns the
# repository, so automation works in any org the App is installed in. Git sends the URL's path
# because automation_git_env in container.yml sets credential.useHttpPath.
input=$(cat)
path=$(printf '%s\n' "$input" | sed -n 's/^path=//p')
case "$path" in
    */*) export GH_OWNER="${path%%/*}" ;;
esac
# The token extension reads GH_REPO before GH_OWNER
unset GH_REPO
printf '%s\n\n' "$input" | exec /home/vscode/.local/bin/gh auth git-credential "$@"
