#!/usr/bin/python3 -I
"""Review T3 Code approvals with an agent.

Usage: t3c-approvals [--config PATH] serve
       t3c-approvals [--config PATH] hook < request.json

`serve` is the t3c-approvals service (/etc/services.d/t3c-approvals/run). It
pairs t3c with the local T3 Code server, ensures the reviewer project, then
runs `t3c requests watch --kind approval` with `hook` for each pending
approval. Questions (user-input requests) are not watched; they stay for a
person. See https://wyrd.foo/docs/t3c/watch-approvals.md for the pattern.

`hook` reads one request record from stdin, starts a reviewer thread in the
reviewer project with the configured provider, model, effort and prompt, and
acts on the last line of its reply: APPROVE accepts, REJECT rejects, anything
else leaves the approval pending. A failed or timed-out review also leaves it
pending, so a person always remains the fallback.

Pairing: every start mints a short-lived pairing token with
`t3 auth pairing create` (the scriptable form of `t3 pair`) and pairs it into a
t3c configuration of its own, T3C_CONFIG_HOME=$XDG_STATE_HOME/t3c-approvals/t3c,
so the user's t3c profiles are not touched.

T3C_APPROVALS_DRY_RUN=1 makes `hook` log the decision without responding.
"""

import json
import os
import re
import shlex
import subprocess
import sys
import time
import tomllib
from pathlib import Path

DEFAULT_CONFIG = "/etc/t3c-approvals/config.toml"
PROFILE = "t3c-approvals"
SCOPES = ("orchestration:read", "orchestration:operate")
VERDICTS = {"APPROVE": "--accept", "REJECT": "--reject"}
# t3c 0.2.4 added `t3c requests watch`
MIN_T3C = (0, 2, 4)


def log(message):
    print(f"[t3c-approvals] {message}", file=sys.stderr, flush=True)


def fail(message, code=1):
    log(f"ERROR: {message}")
    sys.exit(code)


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.environ["HOME"], ".local", "state")
    return Path(base) / "t3c-approvals"


def load_config(path):
    try:
        with open(path, "rb") as file:
            config = tomllib.load(file)
    except (OSError, tomllib.TOMLDecodeError) as error:
        fail(f"cannot read {path}: {error}")
    for key in ("provider", "model", "prompt", "review_dir", "server", "timeout"):
        if not isinstance(config.get(key), str) or not config[key].strip():
            fail(f"{path}: {key} must be a non-empty string")
    if not isinstance(config.get("effort", ""), str):
        fail(f"{path}: effort must be a string")
    projects = config.get("projects", [])
    if not isinstance(projects, list) or not all(isinstance(p, str) and p for p in projects):
        fail(f"{path}: projects must be a list of project ids")
    concurrency = config.get("concurrency", 1)
    if not isinstance(concurrency, int) or isinstance(concurrency, bool) or concurrency < 1:
        fail(f"{path}: concurrency must be a positive integer")
    return config


def t3c(*args, stdin=None, check=True):
    """Run t3c --json and return its parsed result."""
    result = subprocess.run(
        ["t3c", "--json", *args], input=stdin, capture_output=True, text=True
    )
    try:
        data = json.loads(result.stdout) if result.stdout.strip() else {}
    except json.JSONDecodeError:
        data = {}
    if not check:
        data["processExitCode"] = result.returncode
    elif result.returncode != 0:
        detail = (data.get("error") or {}).get("message") or result.stderr.strip() or "no output"
        raise RuntimeError(f"t3c {args[0]} {args[1] if len(args) > 1 else ''} failed "
                           f"({result.returncode}): {detail}")
    return data


def duration_seconds(value):
    units = {"s": 1, "m": 60, "h": 3600}
    if value[-1:] in units and value[:-1].isdigit():
        return int(value[:-1]) * units[value[-1]]
    fail(f"timeout {value!r} is not a duration such as 90s, 5m or 1h")


def check_t3c():
    try:
        out = subprocess.run(["t3c", "--version"], capture_output=True, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return "t3c is not installed (workspace-dotfiles installs @wyrd-company/t3code-cli)"
    try:
        version = tuple(int(part) for part in out.split()[-1].split("-")[0].split("."))
    except ValueError:
        return f"cannot read the t3c version from {out.strip()!r}"
    if version < MIN_T3C:
        want = ".".join(map(str, MIN_T3C))
        return f"t3c {out.split()[-1]} has no `requests watch`; upgrade to {want} or later " \
               "(npm install -g @wyrd-company/t3code-cli)"
    return None


def pair(server, attempts=30, delay=5):
    """Pair t3c with the local server, waiting for it to come up."""
    for attempt in range(1, attempts + 1):
        mint = subprocess.run(
            ["t3", "auth", "pairing", "create", "--base-dir", os.path.join(os.environ["HOME"], ".t3"),
             *[arg for scope in SCOPES for arg in ("--scope", scope)],
             "--ttl", "5m", "--label", PROFILE, "--json"],
            capture_output=True, text=True,
        )
        token = None
        if mint.returncode == 0:
            try:
                token = json.loads(mint.stdout)["credential"]
            except (json.JSONDecodeError, KeyError, TypeError):
                pass
        if token:
            paired = subprocess.run(
                ["t3c", "auth", "pair", "--server", server, "--name", PROFILE, "--pairing-token-stdin"],
                input=token + "\n", capture_output=True, text=True,
            )
            if paired.returncode == 0:
                subprocess.run(["t3c", "auth", "switch", PROFILE], capture_output=True, check=True)
                log(f"paired with {server}")
                return
            reason = paired.stderr.strip() or paired.stdout.strip()
        else:
            reason = mint.stderr.strip() or mint.stdout.strip() or "no pairing token"
        log(f"pairing attempt {attempt}/{attempts} failed: {reason}")
        time.sleep(delay)
    fail(f"could not pair with {server}")


def serve(config_path):
    config = load_config(config_path)
    home = os.environ["HOME"]
    # The container's PATH, which s6 passes on, lacks the user's bin directories, where
    # workspace-dotfiles links t3c
    os.environ["PATH"] = os.pathsep.join(
        [os.environ.get("PATH", ""), os.path.join(home, ".local", "bin"),
         os.path.join(home, ".npm-global", "bin")])
    problem = check_t3c()
    if problem:
        # Wait before exiting, so s6 does not restart this in a tight loop
        log(f"ERROR: {problem}; retrying in 5 minutes")
        time.sleep(300)
        sys.exit(1)

    os.environ["T3C_CONFIG_HOME"] = str(state_dir() / "t3c")
    # The server and credentials come from the paired profile only
    for name in ("T3_SERVER_URL", "T3_TOKEN"):
        os.environ.pop(name, None)
    pair(config["server"])

    review_dir = Path(config["review_dir"])
    review_dir.mkdir(parents=True, exist_ok=True)
    project = t3c("project", "ensure", str(review_dir))["data"]["id"]
    log(f"reviewer project {project} ({review_dir})")

    review_timeout = duration_seconds(config["timeout"])
    os.environ["T3C_APPROVALS_REVIEW_PROJECT"] = project
    hook = shlex.join([os.path.abspath(sys.argv[0]), "--config", config_path, "hook"])
    log(f"watching approvals with {config['provider']}/{config['model']}"
        f" effort={config.get('effort') or 'default'}")
    # The watch prints each request record on stdout; the hook logs what it did on stderr
    devnull = os.open(os.devnull, os.O_WRONLY)
    os.dup2(devnull, 1)
    os.execvp("t3c", [
        "t3c", "requests", "watch", "--ignore-defaults", "--kind", "approval",
        *[arg for watched in config.get("projects", []) for arg in ("--project", watched)],
        "--exec", hook, "--exec-concurrency", str(config.get("concurrency", 1)),
        # Room for the review, then the response
        "--exec-timeout", f"{review_timeout + 60}s", "--log-level", "info",
    ])


# The whole last line, optionally in bold and with a full stop. A verdict in a quote or a code
# block is an example, not a decision: such a last line is not a verdict.
VERDICT_LINE = re.compile(r"(APPROVE|REJECT|ESCALATE)\.?|\*\*(APPROVE|REJECT|ESCALATE)\.?\*\*")


def verdict(reply):
    lines = [line.strip() for line in (reply or "").splitlines() if line.strip()]
    match = VERDICT_LINE.fullmatch(lines[-1]) if lines else None
    return (match.group(1) or match.group(2)) if match else ""


def review_succeeded(reply):
    """Only a review that finished cleanly may decide: t3c can report a completed run together
    with a timeout or interruption error, and exits non-zero then."""
    return (reply.get("processExitCode") == 0 and reply.get("exitCode") == 0
            and not reply.get("error") and reply.get("state") == "completed")


def hook(config_path):
    config = load_config(config_path)
    project = os.environ.get("T3C_APPROVALS_REVIEW_PROJECT")
    if not project:
        fail("T3C_APPROVALS_REVIEW_PROJECT is not set; run under `t3c-approvals serve`")
    data = sys.stdin.read().strip()
    record = json.loads(data)
    request_id = record.get("requestId")
    thread = record.get("thread") or {}
    # Request ids run to hundreds of characters; the thread and the action identify the approval
    action = ((record.get("item") or {}).get("prompt") or "").splitlines()[:1]
    label = f"approval in thread {thread.get('id')} ({action[0][:80] if action else 'no action shown'})"

    if record.get("type") != "request" or record.get("kind") != "approval":
        return
    if (record.get("project") or {}).get("id") == project:
        log(f"skipping {label}: it is from a reviewer thread")
        return
    if (record.get("request") or {}).get("status") != "pending":
        return

    prompt = "\n".join([config["prompt"].strip(), "", data])
    args = ["run", "--project", project, "--provider", config["provider"], "--model", config["model"],
            "--mode", "approval-required", "--title", f"Approval review: {thread.get('title') or thread.get('id')}",
            "--timeout", config["timeout"], "--prompt-file", "-"]
    if config.get("effort"):
        args[1:1] = ["--model-option", f"effort={config['effort']}"]
    log(f"reviewing {label}")
    try:
        reply = t3c(*args, stdin=prompt, check=False)
    except OSError as error:
        fail(f"could not start t3c: {error}")
    decision = verdict(reply.get("assistantMessage")) if review_succeeded(reply) else ""
    reviewer = reply.get("threadId")
    flag = VERDICTS.get(decision)
    if not flag:
        outcome = f"replied {decision}" if decision else "gave no verdict"
        error = (reply.get("error") or {}).get("message")
        log(f"leaving {label} for a person: reviewer {reviewer} {outcome}"
            f" (state {reply.get('state')}{', ' + error if error else ''})")
        return
    if os.environ.get("T3C_APPROVALS_DRY_RUN") == "1":
        log(f"dry run: would respond {flag} to {label} (reviewer {reviewer})")
        return
    try:
        t3c("thread", "respond", f"--request={request_id}", flag, "--", thread["id"])
    except RuntimeError as error:
        # Most often a person answered first
        fail(f"responding {flag} to {label} failed: {error}")
    log(f"responded {flag} to {label} (reviewer {reviewer})")


def main(argv):
    config_path = DEFAULT_CONFIG
    if len(argv) >= 2 and argv[0] == "--config":
        config_path, argv = argv[1], argv[2:]
    if argv == ["serve"]:
        serve(config_path)
    elif argv == ["hook"]:
        hook(config_path)
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
